{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name created in the Cloudflare dashboard.
  "name": "dovera-lab-links",
  "compatibility_date": "2026-10-19",
  // Static export from `next build`; no Worker script.
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Served on *.workers.dev for now. When links.doveralab.com moves to Cloudflare DNS, add:
  // "routes": [{ "pattern": "links.doveralab.com", "custom_domain": true }]
  "workers_dev": true,
  "observability": { "enabled": true }
}
